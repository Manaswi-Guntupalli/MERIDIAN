# ---- Meridian server config ----
NODE_ENV=development
PORT=4000
CLIENT_ORIGIN=http://localhost:5173

# SQLite (default, zero-setup). For Postgres, see docker-compose.yml.
DATABASE_URL="file:./meridian.db"

# Auth
JWT_SECRET=change-me-in-production-meridian-trust-first
JWT_EXPIRES_IN=7d

# OpenAI (optional). If unset, AI features fall back to a deterministic,
# data-grounded simulation so the app is always fully functional.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
